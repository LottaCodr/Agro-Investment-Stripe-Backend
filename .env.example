NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/ayf
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ayf?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_strong_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

# Flutterwave — primary payment provider (Nigeria-first)
# Get from https://dashboard.flutterwave.com/dashboard/settings/api
FLW_PUBLIC_KEY=FLWPUBK_TEST-XXXXXXXXXXXXXXXX-X
FLW_SECRET_KEY=FLWSECK_TEST-XXXXXXXXXXXXXXXX
FLW_ENCRYPTION_KEY=FLWSECK_TESTXXXXXXXXXXXXXXXX
# Secret hash you set in Dashboard → Settings → Webhooks (must match FLW_WEBHOOK_SECRET_HASH)
FLW_WEBHOOK_SECRET_HASH=your_random_webhook_hash_at_least_16_chars
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_REDIRECT_URL=http://localhost:3000/payment/callback
FLW_CURRENCY=NGN

# Legacy Stripe — deprecated but kept for migration (optional)
# STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
# STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Email (Nodemailer / Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@ayf.local

# Cloudinary (optional, for farm image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seed
ADMIN_EMAIL=admin@ayf.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=AYF Admin

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Background workers
ENABLE_ROI_WORKER=true
# REQUIRE_DB=true   # set true to crash if Mongo not reachable (prod)
